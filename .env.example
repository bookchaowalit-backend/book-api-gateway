# Local-only API Gateway pilot settings. Replace the token in your shell;
# never commit a real credential here.
BOOK_API_GATEWAY_TOKEN=replace-with-a-local-token
UPSTREAM_BASE_URL=http://127.0.0.1:9000
UPSTREAM_ALLOWED_HOSTS=127.0.0.1,localhost,::1
UPSTREAM_TIMEOUT_SECONDS=2
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=1048576
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
